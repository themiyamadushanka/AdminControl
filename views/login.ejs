<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — Admin Control</title>
  <meta name="description" content="Secure admin login portal." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f0f1a;
      position: relative;
      overflow: hidden;
    }

    /* Animated gradient orbs */
    body::before, body::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      pointer-events: none;
    }
    body::before {
      width: 500px; height: 500px;
      background: rgba(99, 102, 241, 0.15);
      top: -140px; right: -120px;
      animation: drift 10s ease-in-out infinite;
    }
    body::after {
      width: 420px; height: 420px;
      background: rgba(139, 92, 246, 0.12);
      bottom: -100px; left: -100px;
      animation: drift 12s ease-in-out infinite reverse;
    }
    @keyframes drift {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(20px, -25px); }
    }

    /* Grid dot pattern */
    .grid-bg {
      position: fixed; inset: 0; z-index: 0;
      background-image: radial-gradient(rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 32px 32px;
    }

    /* Card */
    .card {
      position: relative; z-index: 10;
      width: 100%; max-width: 400px;
      margin: 1.5rem;
      background: rgba(22, 22, 38, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 20px;
      padding: 44px 40px 38px;
      box-shadow: 0 24px 60px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.03) inset;
    }

    /* Logo */
    .logo {
      width: 48px; height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 28px;
      box-shadow: 0 6px 20px rgba(99,102,241,.35);
    }
    .logo svg { width: 24px; height: 24px; fill: #fff; }

    h1 {
      font-size: 1.5rem; font-weight: 700; color: #f1f5f9;
      letter-spacing: -.02em; margin-bottom: 6px;
    }
    .subtitle {
      font-size: .85rem; color: #64748b; margin-bottom: 32px;
    }

    /* Error */
    .error-msg {
      display: none; align-items: center; gap: 7px;
      background: rgba(239,68,68,.1);
      border: 1px solid rgba(239,68,68,.25);
      border-radius: 10px;
      padding: 10px 14px; margin-bottom: 18px;
      font-size: .82rem; color: #f87171; font-weight: 500;
    }
    .error-msg.show { display: flex; animation: shake .35s ease; }
    @keyframes shake {
      0%,100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    /* Form */
    .form-group { margin-bottom: 20px; }
    label {
      display: block; font-size: .75rem; font-weight: 600;
      color: #94a3b8; margin-bottom: 7px; letter-spacing: .02em;
      text-transform: uppercase;
    }
    .input-wrap { position: relative; }
    .input-icon {
      position: absolute; left: 14px; top: 50%;
      transform: translateY(-50%);
      color: #475569; pointer-events: none;
      display: flex; transition: color .2s;
    }
    .input-wrap:focus-within .input-icon { color: #818cf8; }

    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 12px 14px 12px 44px;
      background: rgba(255,255,255,.04);
      border: 1.5px solid rgba(255,255,255,.08);
      border-radius: 12px;
      font-size: .9rem;
      font-family: 'Inter', sans-serif;
      color: #f1f5f9;
      outline: none;
      transition: border-color .2s, box-shadow .2s, background .2s;
    }
    input:focus {
      border-color: #6366f1;
      background: rgba(99,102,241,.06);
      box-shadow: 0 0 0 3px rgba(99,102,241,.15);
    }
    input::placeholder { color: #475569; }

    /* Password toggle */
    .toggle-pw {
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #475569; padding: 2px;
      display: flex; align-items: center;
      transition: color .2s;
    }
    .toggle-pw:hover { color: #818cf8; }

    /* Submit */
    .btn-login {
      width: 100%; padding: 13px; margin-top: 8px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff; font-size: .92rem; font-weight: 600;
      font-family: 'Inter', sans-serif;
      border: none; border-radius: 12px;
      cursor: pointer; letter-spacing: .01em;
      position: relative; overflow: hidden;
      box-shadow: 0 4px 16px rgba(99,102,241,.4);
      transition: transform .15s, box-shadow .2s;
    }
    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(99,102,241,.5);
    }
    .btn-login:active { transform: translateY(0); }
    .btn-login:disabled { opacity: .65; cursor: not-allowed; transform: none; }

    /* Spinner */
    .spinner {
      display: none; width: 18px; height: 18px;
      border: 2.5px solid rgba(255,255,255,.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
      margin: 0 auto;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-login.loading .btn-text { display: none; }
    .btn-login.loading .spinner  { display: block; }

    /* Footer */
    .footer {
      text-align: center; margin-top: 28px;
      font-size: .72rem; color: #475569;
    }

    @media (max-width: 480px) {
      .card { padding: 32px 24px 28px; margin: 1rem; }
    }
  </style>
</head>
<body>

  <div class="grid-bg"></div>

  <div class="card" role="main">

    <div class="logo" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2L4 6v5c0 5.25 3.4 10.15 8 11.35C16.6 21.15 20 16.25 20 11V6l-8-4z"/></svg>
    </div>

    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to your admin dashboard</p>

    <!-- Error -->
    <div class="error-msg" id="errorBanner" role="alert">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
      </svg>
      <span id="errorText"></span>
    </div>

    <form id="loginForm" novalidate>

      <!-- Email -->
      <div class="form-group">
        <label for="loginEmail">Email</label>
        <div class="input-wrap">
          <span class="input-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          </span>
          <input type="email" id="loginEmail" name="email" placeholder="you@example.com" autocomplete="email" required />
        </div>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="loginPassword">Password</label>
        <div class="input-wrap">
          <span class="input-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/>
            </svg>
          </span>
          <input type="password" id="loginPassword" name="password" placeholder="Enter your password" autocomplete="current-password" required />
          <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password">
            <svg id="eyeOpen" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
            </svg>
            <svg id="eyeClosed" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none">
              <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78 3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Submit -->
      <button type="submit" class="btn-login" id="loginBtn">
        <span class="btn-text">Sign In</span>
        <div class="spinner" aria-hidden="true"></div>
      </button>

    </form>

    <div class="footer">AdminControl &copy; 2026</div>

  </div>

  <script>
    // Password toggle
    const togglePw  = document.getElementById('togglePw');
    const pwInput   = document.getElementById('loginPassword');
    const eyeOpen   = document.getElementById('eyeOpen');
    const eyeClosed = document.getElementById('eyeClosed');

    togglePw.addEventListener('click', () => {
      const show = pwInput.type === 'password';
      pwInput.type = show ? 'text' : 'password';
      eyeOpen.style.display   = show ? 'none'  : 'block';
      eyeClosed.style.display = show ? 'block' : 'none';
    });

    // Form submit
    const form        = document.getElementById('loginForm');
    const loginBtn    = document.getElementById('loginBtn');
    const errorBanner = document.getElementById('errorBanner');
    const errorText   = document.getElementById('errorText');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner.classList.remove('show');

      const email    = document.getElementById('loginEmail').value.trim();
      const password = pwInput.value;

      if (!email || !password) {
        errorText.textContent = 'Please fill in all fields.';
        errorBanner.classList.add('show');
        return;
      }

      loginBtn.classList.add('loading');
      loginBtn.disabled = true;

      try {
        const res = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        if (res.ok) {
          const data = await res.json().catch(() => ({}));
          window.location.href = data.redirect || '/dashboard';
        } else {
          const err = await res.json().catch(() => ({}));
          errorText.textContent = err.message || 'Invalid credentials.';
          errorBanner.classList.add('show');
        }
      } catch (_) {
        errorText.textContent = 'Network error. Check your connection.';
        errorBanner.classList.add('show');
      } finally {
        loginBtn.classList.remove('loading');
        loginBtn.disabled = false;
      }
    });
  </script>

</body>
</html>