<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Image — Admin Control</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: #f4f7f6;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: #333;
    }
    .upload-container {
      background: #fff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      width: 100%;
      max-width: 400px;
      text-align: center;
    }
    h2 {
      margin-bottom: 8px;
      font-size: 1.5rem;
      color: #1a1a1a;
    }
    p {
      color: #666;
      font-size: 0.9rem;
      margin-bottom: 24px;
    }
    .file-input-wrapper {
      position: relative;
      margin-bottom: 24px;
      border: 2px dashed #d1d5db;
      border-radius: 12px;
      padding: 40px 20px;
      cursor: pointer;
      transition: border-color 0.3s, background 0.3s;
    }
    .file-input-wrapper:hover {
      border-color: #6366f1;
      background: #f8fafc;
    }
    input[type="file"] {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }
    .upload-icon {
      margin-bottom: 12px;
      color: #6366f1;
    }
    .file-name {
      font-size: 0.85rem;
      color: #4b5563;
      margin-top: 10px;
      word-break: break-all;
    }
    button {
      width: 100%;
      padding: 12px;
      background: #6366f1;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s;
    }
    button:hover {
      background: #4f46e5;
    }
  </style>
</head>
<body>

  <div class="upload-container">
    <h2>Upload an Image</h2>
    <p>Select a file from your computer to upload.</p>

    <!-- Important: enctype="multipart/form-data" is required for file uploads -->
    <form action="/imageHandle" method="POST" enctype="multipart/form-data">
      
      <div class="file-input-wrapper">
        <svg class="upload-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <div>Click to select an image</div>
        <div class="file-name" id="fileName">No file chosen</div>
        <input type="file" name="image" id="imageInput" accept="image/*" required />
      </div>

      <button type="submit">Upload Image</button>

    </form>
  </div>

  <script>
    // Just a tiny script to show the selected file name in the UI
    const fileInput = document.getElementById('imageInput');
    const fileNameDisplay = document.getElementById('fileName');
    
    fileInput.addEventListener('change', function() {
      if (this.files && this.files.length > 0) {
        fileNameDisplay.textContent = this.files[0].name;
      } else {
        fileNameDisplay.textContent = 'No file chosen';
      }
    });
  </script>
</body>
</html>
